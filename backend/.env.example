# ─────────────────────────────────────────────────────────────
#  DBSM Hostel Management — Environment Configuration
#  Copy this file to .env and fill in your Railway values
# ─────────────────────────────────────────────────────────────

# ─── OPTION 1: Railway Cloud MySQL (Recommended) ─────────────
# Paste the full MySQL URL from Railway dashboard here:
# MYSQL_URL=mysql://root:PASSWORD@HOST:PORT/railway

# ─── OPTION 2: Manual Host/Port Config ───────────────────────
# MYSQL_HOST=your-railway-host.railway.app
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=railway
# MYSQL_SSL=true

# ─── Local MySQL (development only) ──────────────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=hostel_automation

# ─── App Port ────────────────────────────────────────────────
PORT=5000
